[Unit]
Description=DeepSeek-V4.1-Flash (XTier TP2, GPU0+GPU2)
Documentation=file:/opt/Xtier/run-ds41-l20-tp2.sh
Documentation=file:/opt/Xtier/start-ds41-with-console.sh
Documentation=file:/opt/Xtier/snapshots/prod/manifest.txt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Xtier

# ============================================================================
# ★ 生产配置的唯一权威面（2026-11-20 对齐版）
#
# 约定（务必遵守，否则会出「unit 里改了却不生效」的坑）：
#   1) 本文件只放「启动脚本用 ${VAR:-默认值} 读取」的变量 —— 即真正可覆盖的旋钮。
#      脚本里写成 `export VAR=xxx`（写死）的变量不要往这里放：脚本会覆盖 unit，
#      写进来只会误导人以为改了有用。
#   2) 本文件的每个值都必须等于脚本里的默认值（两边同值），
#      这样「直接跑脚本」和「走 systemd」行为完全一致。
#      verify_prod.sh 会逐项交叉校验，任何一处不一致都会报 FAIL。
#   3) 改这里 = 改生产，必须 `systemctl restart DeepSeek-V4.1-Flash` 才生效。
#   4) 命令行参数不在这里（全部在 run-ds41-l20-tp2.sh 的 ARGS[] 里），
#      避免 unit 变成几百行的命令清单。
# ============================================================================

# ---- 硬件放置：GPU0(node0) + GPU2(node1)，一卡一 NUMA 节点 ----
# XTier 的 TP 放置要求每个 rank 一个 CPU 引擎进程 + 自己的 NUMA 节点：
# 两个 rank 若同在 node0 会拿到完全相同的 CPU 集合（实测 29/29 重叠，
# 每层 CPU 从 257us 劣化到 8812us）。
# GPU0 在 node0、GPU2 在 node1（nvidia-smi topo -m: GPU0↔GPU2 = SYS），
# 各卡的专家权重与 GPU 同域；代价是 all-reduce 走 UPI —— 这是有意为之，不是笔误。
Environment=CUDA_VISIBLE_DEVICES=0,2
# NCCL 走 host bridge 而非整机内存中转（实战报告：all-reduce 3.83 -> 19.57 GB/s）
Environment=NCCL_P2P_LEVEL=PHB
# rank0->node0(GPU0), rank1->node1(GPU2)。必须显式写：默认 auto 在两卡同节点时会退化
Environment=XTIER_TP_NODES=0|1
# 每个 rank 一个节点（32 物理核），一 worker 一物理核，SMT 兄弟核留给主线程。
# 40/48/56 更差：只能在同一物理核塞第 2 个 worker，SMT 不翻倍，且主线程被挤到 7 CPU。
Environment=XTIER_THREADS=32
# 必须 0：否则锁页内存吃掉大页
Environment=XTIER_THP=0

# ---- DSpark 投机解码（accept_len 3.5 vs 1.0 的主要来源）----
# DSPARK=1 才会 export XTIER_DRAFT=1 + SGLANG_RAGGED_VERIFY_MODE=compact。
# compact = 变长验证 => rows_per_request=1 => 走 SGLang 自己的 JIT indexer metadata；
# static（默认）= 固定 6 行 => 调 deep_gemm.get_paged_mqa_logits_metadata，
#                             它在 SM89 (L20) 返回 None => assert 崩。
Environment=DSPARK=1
# 本机 L20 实测的投机接受率表（没有它 DSpark 也能跑，但没有调优收益）
Environment=SPS_TABLE=/opt/Xtier/sps-table-l20-gpu02.json
Environment=SGLANG_RAGGED_VERIFY_MODE=compact
# Mamba 状态缓存 16 条（推理会话级 KV）
Environment=MAMBA_CACHE=16

# ---- 专家缓存（命中率 74% 的关键，决定性提速项）----
# 常驻 43 槽 = CHUNK_SLOTS['32768']，是「弹性关掉时」的下限。
# 80 槽会把显存吃到只剩 ~5MB，allocator 反复 OOM 回落，prefill 2.8K -> 600 tok/s。
Environment=XTIER_CACHE_SLOTS=43
# 弹性：base 0.5 => 常驻 21 槽；上限 64 = 21 常驻 + 43 弹性槽。
# 43 -> 64：命中率 62%->74%，4 路吞吐 +33%，8 路 >200ms 49%->4%；
# 涨满后余 5.0GB > reserve 2GB，零 OOM。
Environment=XTIER_CACHE_ELASTIC=1
Environment=XTIER_CACHE_ELASTIC_BASE=0.5
Environment=XTIER_CACHE_ELASTIC_MAX_SLOTS=64
# 换页节奏：每 2 个 decode window 换一轮、每轮 32 次。
# 换页要从主机内存读专家、和 CPU 引擎抢内存带宽，所以宁少勿多。
Environment=XTIER_CACHE_EVERY=2
Environment=XTIER_CACHE_SWAPS=32
# 换入门槛 3 / 遗忘衰减 0.9（源码默认 1.5 / 0.7）：门槛高、忘得慢 => 少换页。
# 实测 swaps/round 111 -> 63，命中率 0.654 -> 0.671，每层 CPU 1023 -> 985us。
Environment=XTIER_CACHE_MIN_GAIN=3
Environment=XTIER_CACHE_DECAY=0.9
# agent 场景三件套：用 prefill 路由预热、借 prefill 显存当额外热槽、更激进的自适应换入。
# prompt 预热 64 次 x 8 轮（总量与 256x4 相同，但轮次多、每次少，仓库报告里这个组合最好）
Environment=XTIER_CACHE_PROMPT_ROUNDS=8
Environment=XTIER_CACHE_PROMPT_SWAPS=64
# 本机 L20 实测路由统计（不占显存，只决定热槽初始装谁）
Environment=XTIER_CACHE_PROFILE=/opt/Xtier/ds41-profile-l20.json
# worker 空转时自旋多少次再 futex 休眠。
# 生产配置用 1048576（100 万次 pause）会让 64 个 worker 长期忙等（整机 80% us）；
# 32768 下负载 CPU 占用 1.7-39%，吞吐不变（机器上还有别的服务，省下来的核很值）。
Environment=XTIER_SPIN_COUNT=32768

# ---- Engram 表（189 GB）走 NVMe，按行读 ----
Environment=XTIER_ENGRAM_CACHE_GIB=4

# ---- 服务参数（与脚本 ARGS[] 一一对应）----
Environment=M=/opt/models/unsloth/DeepSeek-V4.1-Flash-1017
Environment=PORT=8001
Environment=TP_SIZE=2
# PDI：prefill 之后强制跑多少个 decode 轮再排下一个 prefill（0 = 不穿插）。
# 这是「多请求卡顿」的开关：0 时几个长上下文的 prefill 会连成一段几百秒的连续 prefill，
# 期间所有已就绪的请求一个 token 都发不出来——实测 6 路 x 100K 时最大 token 停顿 116 秒。
# 32：停顿降到 330 ms，8x4 agent 吞吐 +27%，冷 prefill 不变；64 会把新请求的 TTFT p95 推到 16s。
Environment=PDI=32
# fcfs 而非 lpm：lpm 按最长前缀插队，会把队尾请求的第 2 轮 prefill 一再推迟
# （多 agent 场景是负优化）。12 路并发实测 wall 216s->117s、吞吐 +80%、无饿死。
Environment=SCHEDULE=fcfs
# 8 = 本机(L20/SM89 + DSpark)的真实硬顶：bs>8 时 CUDA graph 无法 replay(只捕获 bs 1..8)
# -> compact(ragged) verify 失效 -> 退化成 static(rows_per_request=5)
# -> 跳过 JIT indexer planner -> deep_gemm.get_paged_mqa_logits_metadata 在 SM89 返回 None
# -> assert 崩。过 8 只有三条路：放弃 DSpark / 换 SM100+ 机器 / 改 SGLang 上游 kernel 元数据规划器。
Environment=MAX_REQ=8
# chunk 32K：每个 prefill chunk 都要为 40 层重传全部 384 个专家（3.36 GiB/层/卡），
# chunk 越大上传轮数越少。实测冷 100K prefill：8K=1597、16K=2498、32K=3028 tok/s。
Environment=CHUNK=32768
Environment=PREFILL_TOKENS=32768
Environment=PREFILL_REQ=8
Environment=GRAPH_BS=8
Environment=CONTEXT=262144
# KV 池 1.5M token（脚本默认已改成同值；此前 unit=1572864 而脚本=524288，差 3 倍）
Environment=KV_POOL=1572864
Environment=MEM=0.88

# ---- 运行时 ----
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# 钉住 rustup 工具链：/opt/sglang/rust/rust-toolchain.toml 要 1.92 + clippy/rustfmt，
# 缺组件时 rustup 会在后台下载并卡死几十秒到几分钟，SGLang 的 Rust 图像处理器探测就会挂在这里。
Environment=RUSTUP_TOOLCHAIN=1.92-x86_64-unknown-linux-gnu

# 模型日志落到固定文件；8100 看板是独立服务（xtier-dashboard.service），只读跟随此日志
StandardOutput=append:/var/log/llm/DeepSeek-V4.1-Flash.log
StandardError=append:/var/log/llm/DeepSeek-V4.1-Flash.log
ExecStart=/bin/bash /opt/Xtier/start-ds41-with-console.sh
Restart=on-failure
RestartSec=20
TimeoutStartSec=1200
KillMode=process

[Install]
WantedBy=multi-user.target
