+# Ada Lovelace (SM89): FP8 tensor cores exist since SM89, but the arch has no
+# TMA/wgmma, so the Hopper-only kernels stay off. The generic Triton kernels
+# (block-FP8 W8A8 with SPLIT_K / SWAP_AB) do run here, so features that only
+# need "FP8 tensor cores" may gate on this instead of is_sm90.
+is_sm89_supported = lru_cache(maxsize=1)(
+    partial(
+        _check_cuda_device_version, device_capability_majors=[8], cuda_version=(12, 0)
+    )
+)
